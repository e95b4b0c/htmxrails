<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <%# Swapped out-of-band by page_nav when htmx loads a fragment. %>
    <title id="page-title"><%= content_for(:title) || "HTMX on Rails" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Htmxrails">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>

    <%# The import map plus application.js, which imports htmx from
        vendor/javascript/htmx.esm.js (see config/importmap.rb). %>
    <%= javascript_importmap_tags %>
  </head>

  <%# hx-headers rides on <body> and is inherited by every element below, which
      is how every htmx request carries the CSRF token. %>
  <%= tag.body(**htmx_body_attributes, class: "app") do %>
    <div class="shell">
      <%= render "shared/header", current: @current_page %>

      <%# The single region htmx ever swaps. %>
      <main id="main-content" class="content">
        <%= yield %>
      </main>

      <%= render "shared/footer" %>
    </div>

    <%# Filled by the contact:message-sent listener in application.js. %>
    <div id="toast-region" class="toast-region" aria-live="polite" aria-atomic="true"></div>
  <% end %>
</html>
